# Preferred local database: PostgreSQL.
# Host port 5433 matches docker-compose.yml when the database service is running.
DATABASE_URL=postgresql+psycopg://todo:todo@localhost:5433/todo

# SQLite is supported for local development without PostgreSQL:
# DATABASE_URL=sqlite:///./todo.db

LOG_LEVEL=INFO

# Comma-separated browser origins, or * for any origin.
CORS_ORIGINS=*
